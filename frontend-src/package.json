{
  "name": "tomoshibi",
  "version": "1.2.1",
  "packageManager": "pnpm@10.16.1",
  "description": "Tomoshibi — 桌面 AI 陪伴，衍生自 Open-LLM-VTuber",
  "main": "./out/main/index.js",
  "author": "",
  "homepage": "",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:fix": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "node scripts/typecheck-web.mjs",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && node scripts/fetch-uv.mjs && node scripts/stage-backend.mjs && electron-builder --dir",
    "build:win": "npm run build && node scripts/fetch-uv.mjs win && node scripts/stage-backend.mjs && electron-builder --win",
    "build:mac": "electron-vite build && node scripts/fetch-uv.mjs mac && node scripts/stage-backend.mjs && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "dev:web": "vite serve src/renderer --config vite.config.ts",
    "build:web": "vite build --config vite.config.ts --mode web",
    "extract-translations": "i18next-scanner --config i18next-scanner.config.js",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:defines": "node scripts/check-build-defines.mjs",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@ark-ui/react": "5.5.0",
    "@chakra-ui/react": "^3.2.3",
    "@chatscope/chat-ui-kit-react": "^2.0.3",
    "@chatscope/chat-ui-kit-styles": "^1.4.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@emotion/react": "^11.14.0",
    "@pixiv/three-vrm": "3.5.5",
    "@pixiv/three-vrm-animation": "3.5.5",
    "@ricky0123/vad-web": "^0.0.24",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.1.7",
    "eslint": "^8.57.1",
    "framer-motion": "^11.14.4",
    "i18next": "^25.0.1",
    "i18next-browser-languagedetector": "^8.0.5",
    "i18next-scanner": "^4.6.0",
    "next-themes": "^0.4.4",
    "onnxruntime-web": "1.14.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.5.1",
    "react-icons": "^5.4.0",
    "rxjs": "^7.8.1",
    "three": "^0.185.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.14.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "electron": "31.7.6",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint-plugin-react": "^7.34.3",
    "prettier": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.5.2",
    "vite": "^5.3.1",
    "vite-plugin-static-copy": "^2.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@swc/core",
      "protobufjs"
    ]
  },
  "license": "SEE LICENSE IN LICENSE"
}
