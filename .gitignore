!src/open_llm_vtuber/asr/models/silero_vad.onnx
asset
models/*
!models/piper_voice
models/piper_voice/*


# Legacy and specific directories
legacy/
chat_history/
knowledge_base/
submodules/MeloTTS
openapi_assistants.json
openapi_memgpt.json

# memory log
mem.json
conf.yaml.backup

*.exe

tmp/
private/
mcp_servers.json

.vscode/
# runtime artifacts
conf.yaml.bak
# 帶時戳的備份（character_route 與手動改設定時各會留一份）
conf.yaml.bak.*
*.bak
prompts/utils/proactive_topics.json
prompts/utils/seen_news.json
prompts/utils/proactive_speak_prompt.txt

# Electron 外殼

